# Python
__pycache__/

# Local script cache for the encoder pipeline (~900 MB checkpoint +
# 850 MB exported encoder ONNX). Never commit.
.cache/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Node
node_modules/
.next/
out/
.vercel/

# Env
.env
.env.local
.env.*.local
!.env.example

# Encoder weights stay out of git (~850 MB).
weights/
*.onnx.data
*.pt
*.safetensors
output_models/
original_models/

# Allow the small decoder model + a pre-baked demo bundle to ship with
# the Vercel template (so the deploy button produces a working app).
*.onnx
!apps/web/public/models/*.onnx

# Notebook output at the repo root (one-off bundles users produce while
# running the encoder). These should NOT be committed.
*.zip
/embedding.bin
/manifest.json
/preview.jpg

# But the pre-baked demo bundles under the web app ARE part of the
# template — keep them tracked so "Deploy to Vercel" produces a
# working app on first paint.
!apps/web/public/demos/**

# OS
.DS_Store
.idea/
.vscode/
